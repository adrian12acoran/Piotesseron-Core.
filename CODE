class Piotesseron:

    def __init__(
        self,
        config: Optional[
            PiotesseronConfig
        ] = None,
    ) -> None:

        self.config = (
            config
            or PiotesseronConfig()
        )

        self.builder = (
            UEEBuilder()
        )

        self.alcyone = (
            Alcyone(
                self.config
            )
        )

        self.history: List[
            Dict[
                str,
                Any,
            ]
        ] = []

        self._assert_invariants()

    def _assert_invariants(
        self,
    ) -> None:

        if (
            self.alcyone.name
            != "Alcyone"
        ):

            raise RuntimeError(
                "Invariant violation: "
                "Alcyone identity changed."
            )

        if not (
            self.alcyone
            .is_major
        ):

            raise RuntimeError(
                "Invariant violation: "
                "Alcyone must be Major."
            )

        if (
            self.alcyone
            .pi
            .A3
            != 3
        ):

            raise RuntimeError(
                "Invariant violation: "
                "A3 must remain 3."
            )

    def evaluate(
        self,
        raw: Any,
        identifier: Optional[
            str
        ] = None,
        context: Optional[
            Mapping[
                str,
                Any,
            ]
        ] = None,
        external: bool = False,
    ) -> Decision:

        uee = (
            self.builder
            .build(
                raw,
                identifier,
                context,
                external,
            )
        )

        decision = (
            self.alcyone
            .integrate(
                uee
            )
        )

        if (
            self.config
            .keep_history
        ):

            self.history.append(
                decision.to_dict()
            )

        return decision

    def reenter(
        self,
        previous_decision: Decision,
        new_evidence: Any,
        context: Optional[
            Mapping[
                str,
                Any,
            ]
        ] = None,
    ) -> Decision:

        previous = (
            previous_decision
            .trajectory
        )

        raw = {
            "previous_trajectory": {
                "content": (
                    previous
                ),

                "modality": (
                    "contextual"
                ),

                "weight": 0.65,

                "reliability": 0.75,

                "completeness": 0.75,

                "coherence": 0.75,

                "noise": 0.15,
            },

            "new_evidence": (
                new_evidence
            ),
        }

        identifier = (
            f"{previous['uee_id']}"
            f"-REENTRY-"
            f"{len(self.history) + 1}"
        )

        return self.evaluate(
            raw,
            identifier,
            context,
            external=True,
        )

    def evaluate_batch(
        self,
        samples: Sequence[
            Any
        ],
        contexts: Optional[
            Sequence[
                Optional[
                    Mapping[
                        str,
                        Any,
                    ]
                ]
            ]
        ] = None,
    ) -> List[
        Decision
    ]:

        contexts = (
            list(
                contexts
            )
            if contexts
            is not None
            else [
                None
            ] * len(
                samples
            )
        )

        if (
            len(contexts)
            != len(samples)
        ):

            raise ValueError(
                "contexts and samples "
                "must have the same length."
            )

        return [
            self.evaluate(
                sample,
                identifier=(
                    f"BATCH-"
                    f"{index:08d}"
                ),
                context=context,
                external=True,
            )

            for index, (
                sample,
                context,
            )
            in enumerate(
                zip(
                    samples,
                    contexts,
                )
            )
        ]

    def internal_states(
        self,
        samples: Sequence[
            Any
        ],
        contexts: Optional[
            Sequence[
                Optional[
                    Mapping[
                        str,
                        Any,
                    ]
                ]
            ]
        ] = None,
    ) -> List[str]:

        return [
            decision
            .internal_state
            .value

            for decision
            in self.evaluate_batch(
                samples,
                contexts,
            )
        ]

    def conceptual_states(
        self,
        samples: Sequence[
            Any
        ],
        contexts: Optional[
            Sequence[
                Optional[
                    Mapping[
                        str,
                        Any,
                    ]
                ]
            ]
        ] = None,
    ) -> List[str]:

        return [
            decision
            .internal_state
            .conceptual_label

            for decision
            in self.evaluate_batch(
                samples,
                contexts,
            )
        ]

    def predict(
        self,
        samples: Sequence[
            Any
        ],
        contexts: Optional[
            Sequence[
                Optional[
                    Mapping[
                        str,
                        Any,
                    ]
                ]
            ]
        ] = None,
    ) -> np.ndarray:

        return np.asarray(
            [
                decision
                .binary_output

                for decision
                in self.evaluate_batch(
                    samples,
                    contexts,
                )
            ],
            dtype=np.int64,
        )

    def predict_proba(
        self,
        samples: Sequence[
            Any
        ],
        contexts: Optional[
            Sequence[
                Optional[
                    Mapping[
                        str,
                        Any,
                    ]
                ]
            ]
        ] = None,
    ) -> np.ndarray:

        probability_one = np.asarray(
            [
                decision
                .binary_probability

                for decision
                in self.evaluate_batch(
                    samples,
                    contexts,
                )
            ],
            dtype=np.float64,
        )

        probability_zero = (
            1.0
            - probability_one
        )

        return np.column_stack(
            [
                probability_zero,
                probability_one,
            ]
        )

    def save_history(
        self,
        path: str = (
            "piotesseron_trajectory.json"
        ),
    ) -> str:

        with open(
            path,
            "w",
            encoding="utf-8",
        ) as file:

            json.dump(
                self.history,
                file,
                ensure_ascii=False,
                indent=2,
            )

        return path

    def clear_history(
        self,
    ) -> None:

        self.history.clear()


