        "72458700660631558817488152092096282925409171536436"
        "78925903600113305305488204665213841469519415116094"
    )

    def __init__(self, anchor: int = 3) -> None:
        if anchor != 3:
            raise ValueError("A3 is inviolable. The primary anchor must remain 3.")
